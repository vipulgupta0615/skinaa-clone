# Render injects PORT automatically. Keep 4000 for local API development.
PORT=4000

# MongoDB Atlas (or another MongoDB provider) connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/skinaa

# Exact Vercel production URL; separate multiple allowed origins with commas.
FRONTEND_ORIGIN=http://localhost:3000

# Test checkout only. Set securely in Render; never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
